# Copy to .env and fill in. Never commit .env.
DEMO_MODE=true
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# LLM: gemini | anthropic | openai. Leave LLM_API_KEY empty to run on the keyword fallback only.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
# used for the one retry (e.g. when the main model returns 503 overloaded)
LLM_MODEL_FALLBACK=gemini-flash-lite-latest
LLM_TIMEOUT_MS=8000

# Optional: fixed secret so demo sessions survive server restarts
SESSION_SECRET=
